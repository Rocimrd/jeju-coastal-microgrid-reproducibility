+static AuditMode parseAuditMode(const std::string& s) {
+    if (s == "BASE") return AuditMode::BaseEconomic;
+    if (s == "MINRO") return AuditMode::MinRO;
+    if (s == "MAXRO") return AuditMode::MaxRO;
+    throw std::runtime_error("Unknown audit mode: " + s);
+}
