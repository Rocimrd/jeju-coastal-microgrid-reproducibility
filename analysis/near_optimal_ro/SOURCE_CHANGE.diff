+static const char* auditModeName(AuditMode mode) {
+    switch (mode) {
+    case AuditMode::BaseEconomic: return "BASE";
+    case AuditMode::MinRO: return "MINRO";
+    case AuditMode::MaxRO: return "MAXRO";
+    default: return "NONE";
